#!/bin/sh
# Re-checks everything about to be pushed: files, diffs, commit messages, authors.
. "$(git rev-parse --show-toplevel)/scripts/hooks/leak-guard.sh"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # branch deletion
  # Only the snapshot branch may leave this machine (see scripts/publish.ps1); main keeps its
  # full local history.
  if [ "$local_ref" != "refs/heads/public" ]; then
    echo "leak-guard: only the 'public' branch may be pushed (got $local_ref)." >&2
    echo "            Publish with: .\\scripts\\publish.ps1 -Message \"...\"" >&2
    status=1
    continue
  fi
  # New branch, force push or unknown remote state: check everything that would be on the remote.
  if [ "$remote_sha" = "$zero" ] || ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  bad=$(git log --name-only --format= "$range" | sort -u | blocked_paths)
  if [ -n "$bad" ]; then
    echo "leak-guard: push contains private files:" >&2
    echo "$bad" | sed 's/^/  /' >&2
    status=1
  fi
  git log -p --no-color --format='%an %ae%n%B' "$range" | check_text "commits in $local_ref" || status=1
done
[ $status -eq 0 ] || echo "leak-guard: push aborted." >&2
exit $status
